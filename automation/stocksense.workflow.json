    {
      "id": "count-durable-writes",
      "name": "Count durable writes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ],
      "parameters": {
        "jsCode": "const counts = {received:0,normalized:0,inserted:0,duplicates:0}; for(const i of $input.all()) for(const key of Object.keys(counts)) counts[key] += Number(i.json[key] || 0); return [{json:counts}];"
      }
